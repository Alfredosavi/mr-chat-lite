# Twitch Client ID
#
# Register an application at:
# https://dev.twitch.tv/console/apps
#
# Configure the application as a Public Client.
#
# The Client ID is public and is used by the frontend to authenticate
# with Twitch using the Device Code Grant flow.
#
# Never add a Twitch Client Secret to this project.

VITE_TWITCH_CLIENT_ID=seu_client_id
